---
import Blurrable from "../components/Blurrable.astro";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import noisySvg from "../assets/noise.svg";
import GetClientTime from "../components/GetClientTime.astro";
import PortfolioTypography from "../components/PortfolioTypography.astro";
import PortfolioSurface from "../components/PortfolioSurface.astro";
import SocialPreview from "../components/SocialPreview.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Josh's personal site" } = Astro.props;

const buildTime = new Date();
const noiseBackgroundSvg = `url(${noisySvg.src})`;
const darkColor = "#0c0a09";
const lightColor = "#fafaf9";
---

<!doctype html>
<html lang="en" data-portfolio>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <SocialPreview title={title} description={description} />
    <PortfolioTypography />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-status-bar-style" id="apple-status-bar" content="default" />
    <meta name="theme-color" id="theme-color" content={lightColor} />
    <script is:inline define:vars={{ darkColor, lightColor }}>
      const root = document.documentElement;
      let savedTheme;
      try {
        savedTheme = window.localStorage.getItem("portfolio-theme");
      } catch {}
      const preference =
        savedTheme === "light" || savedTheme === "dark" || savedTheme === "system"
          ? savedTheme
          : "system";
      const dark =
        preference === "dark" ||
        (preference === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
      root.dataset.themePreference = preference;
      root.classList.toggle("dark", dark);
      document.getElementById("theme-color").setAttribute("content", dark ? darkColor : lightColor);
      document
        .getElementById("apple-status-bar")
        .setAttribute("content", dark ? "black-translucent" : "default");
    </script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body
    class="min-h-[100dvh] bg-stone-50 dark:bg-stone-950 dark:text-zinc-50"
    data-darkcolor={darkColor}
    data-lightcolor={lightColor}
  >
    <slot />
    <footer data-portfolio-footer class="mt-56 px-4">
      <div class="w-full h-[1px] bg-zinc-500 dark:bg-zinc-600 slight-x-mask"></div>
      <section data-footer-content class="mx-auto max-w-2xl py-10 font-mono text-pretty space-y-8">
        <div>
          <a data-type="entry" href="/" class="font-mono">Joshua Constantine Santos</a>
          <p data-type="prose" class="text-sm">
            <span class="text-zinc-500 dark:text-zinc-400"> connect with me </span>
            <a href="https://www.twitter.com/mrnicericee" target="_blank" class="underline"
              >@Twitter</a
            >
            <span class="text-zinc-500 dark:text-zinc-400"> or on </span>
            <a
              href="https://www.linkedin.com/in/joshua-constantine-santos/"
              target="_blank"
              class="underline"
              >LinkedIn</a
            ><span class="text-zinc-500 dark:text-zinc-400">. Look through some of my code on
            </span>
            <a href="https://github.com/mrnicericee" target="_blank" class="underline"> GitHub</a>
          </p>
        </div>
        <p data-type="prose" class="text-sm">
          <span class="text-zinc-500 dark:text-zinc-400"> Silly little guy made by </span>
          <span class="whitespace-nowrap"
            ><a href="https://gyuppii.carrd.co" target="_blank" class="underline">Gyuppii</a>.</span
          ><Blurrable><span class="text-zinc-500 dark:text-zinc-400">I absolutely
              <bold class="font-bold">love</bold> the silly little guy, on mobile he goes to the
              bottom right corner and just chills.
            </span>
          </Blurrable>
        </p>
        <div data-type="metadata" class="space-y-2 text-sm pb-6">
          <GetClientTime />
          <p>
            build time
            <span class="tabular-nums"
              >{Intl.DateTimeFormat(undefined, {
                year: "numeric",
                month: "long",
                day: "numeric",
                hour: "numeric",
                minute: "numeric",
                second: "numeric",
              }).format(buildTime)}</span
            >
          </p>
          <p>
            Built in <a href="https://astro.build/" target="_blank" class="underline">Astro</a>,
            made with ❤️
          </p>
        </div>
      </section>
      <PortfolioSurface />
    </footer>
  </body>
</html>

<style
  is:global
  define:vars={{
    noiseSvg: noiseBackgroundSvg,
  }}
>
  :root {
    --mask-left-start: 25%;
    --mask-left-end: 75%;
  }

  @keyframes static {
    from {
      transform: translateX(-1000px);
    }

    33% {
      transform: translateY(-1000px);
    }

    66% {
      transform: translateX(1000px);
    }

    to {
      transform: translateY(1000px);
    }
  }

  :root {
    --focus-ink: #665346;
    --focus-surface: #e8dfcc;
  }

  html.dark {
    --focus-ink: #d8c8aa;
    --focus-surface: #302a21;
  }

  /* a warm wash behind the immediate ink edge */
  :where(a[href], button, summary, input, select, textarea):focus-visible {
    /* keep focused content readable above the fixed character */
    position: relative;
    z-index: 2;
    background-color: var(--focus-surface);
    box-shadow: 0 0 0 3px var(--focus-surface);
    outline: 2px solid var(--focus-ink);
    outline-offset: 2px;
    border-radius: 2px;
    transition: none;
  }

  summary:focus-visible {
    outline-offset: 4px;
  }

  astro-blurrable button {
    margin-block: 4px;
  }

  a[href]:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  summary:focus-visible > svg,
  astro-blurrable button:focus-visible > span {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .grainy-light,
    html.dark .grainy-light {
      animation: none;
    }
  }

  @media (forced-colors: active) {
    :where(a[href], button, summary, input, select, textarea):focus-visible {
      box-shadow: none;
      outline-color: Highlight;
    }
  }

  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
</style>

<script>
  import { initializePortfolioTheme } from "../scripts/portfolioTheme";
  initializePortfolioTheme();
</script>
