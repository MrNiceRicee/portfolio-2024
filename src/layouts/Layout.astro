---
import Blurrable from "../components/Blurrable.astro";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import noisySvg from "../assets/noise.svg";
import GetClientTime from "../components/GetClientTime.astro";
import PortfolioTypography from "../components/PortfolioTypography.astro";
import ProposalSurface from "../components/ProposalSurface.astro";
import { getProposalConfig } from "../scripts/proposalConfig";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Josh's personal site" } = Astro.props;

const serverTime = new Date();
const noiseBackgroundSvg = `url(${noisySvg.src})`;
const darkColor = "#181615";
const lightColor = "#ebebec";
const proposal = getProposalConfig(Astro.url);
---

<!doctype html>
<html lang="en" class={proposal.enabled ? (proposal.theme === "dark" ? "dark" : "") : "dark"}
  data-proposal={proposal.enabled ? "" : undefined}
  data-proposal-theme={proposal.enabled ? proposal.theme : undefined}
  data-fallback={proposal.enabled && proposal.fallback ? "" : undefined}>
  <head>
    <meta charset="UTF-8" />
    {proposal.enabled && <PortfolioTypography />}
    <script is:inline>
      const root = document.documentElement;
      const explicitTheme = root.dataset.proposalTheme;
      let savedTheme;
      try { savedTheme = window.localStorage.getItem("portfolio-theme"); } catch {}
      const preference = explicitTheme === "light" || explicitTheme === "dark" ? explicitTheme
        : savedTheme === "light" || savedTheme === "dark" || savedTheme === "system" ? savedTheme : "system";
      root.dataset.themePreference = preference;
      root.classList.toggle("dark", preference === "dark"
        || (preference === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches));
    </script>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      id="apple-status-bar"
      content="default"
    />
    <meta name="theme-color" id="theme-color" content={darkColor} />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    class="min-h-[100dvh] bg-stone-50 dark:bg-stone-950 dark:text-zinc-50"
    data-darkcolor={darkColor}
    data-lightcolor={lightColor}
  >
    <slot />
    <footer data-portfolio-footer class="mt-56 px-4">
      <div class="w-full h-[1px] bg-zinc-500 dark:bg-zinc-600 slight-x-mask">
      </div>
      <section data-footer-content class="mx-auto max-w-2xl py-10 font-mono text-pretty space-y-8">
        <div>
          <a data-type="entry" href="/" class="font-mono">Joshua Constantine Santos</a>
          <p data-type="prose" class="text-sm">
            <span class="text-zinc-500 dark:text-zinc-400">
              connect with me
            </span>
            <a
              href="https://www.twitter.com/mrnicericee"
              target="_blank"
              class="underline">@Twitter</a
            >
            <span class="text-zinc-500 dark:text-zinc-400"> or on </span>
            <a
              href="https://www.linkedin.com/in/joshua-constantine-santos/"
              target="_blank"
              class="underline">LinkedIn</a
            ><span class="text-zinc-500 dark:text-zinc-400"
              >. Look through some of my code on
            </span>
            <a
              href="https://github.com/mrnicericee"
              target="_blank"
              class="underline"
            >
              GitHub</a
            >
          </p>
        </div>
        <p data-type="prose" class="text-sm">
          <span class="text-zinc-500 dark:text-zinc-400">
            Silly little guy made by
          </span>
          <a href="gyuppii.carrd.co" target="_blank" class="underline"
            >Gyuppii</a
          ><Blurrable
            ><span class="text-zinc-500 dark:text-zinc-400"
              >. I absolutely <bold class="font-bold">love</bold> the silly little
              guy, on mobile he goes to the bottom right corner and just chills.
            </span>
          </Blurrable>
        </p>
        <div data-type="metadata" class="space-y-2 text-sm pb-6">
          <GetClientTime />
          <p>
            current server time <span class="tabular-nums"
              >{
                Intl.DateTimeFormat(undefined, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  hour: "numeric",
                  minute: "numeric",
                  second: "numeric",
                }).format(serverTime)
              }</span
            >
          </p>
          <p>
            Built in
            <a href="https://astro.build/" target="_blank" class="underline"
              >Astro</a
            >, made with ❤️
          </p>
        </div>
      </section>
      {proposal.enabled && <ProposalSurface />}
    </footer>
    {!proposal.enabled && <div class="grainy-light dark:grainy-dark z-50"></div>}
    <!-- canvas  -->
    {!proposal.enabled && <canvas
      id="canvas"
      class="fixed inset-0 pointer-events-none z-[100] dark:opacity-25 opacity-35 motion-reduce:hidden"
      aria-hidden="true"></canvas>}
  </body>
</html>

<style
  is:global
  define:vars={{
    noiseSvg: noiseBackgroundSvg,
    darkColor,
    lightColor,
  }}
>
  :root {
    --mask-left-start: 25%;
    --mask-left-end: 75%;
  }

  @keyframes static {
    from {
      transform: translateX(-1000px);
    }

    33% {
      transform: translateY(-1000px);
    }

    66% {
      transform: translateX(1000px);
    }

    to {
      transform: translateY(1000px);
    }
  }

  :root {
    --focus-ink: #665346;
    --focus-surface: #e8dfcc;
  }

  html.dark {
    --focus-ink: #d8c8aa;
    --focus-surface: #302a21;
  }

  /* a warm wash behind the immediate ink edge */
  :where(a[href], button, summary, input, select, textarea):focus-visible {
    /* keep focused content readable above the fixed character */
    position: relative;
    z-index: 2;
    background-color: var(--focus-surface);
    box-shadow: 0 0 0 3px var(--focus-surface);
    outline: 2px solid var(--focus-ink);
    outline-offset: 2px;
    border-radius: 2px;
    transition: none;
  }

  summary:focus-visible {
    outline-offset: 4px;
  }

  astro-blurrable button {
    margin-block: 4px;
  }

  a[href]:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  summary:focus-visible > svg,
  astro-blurrable button:focus-visible > span {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .grainy-light, html.dark .grainy-light {
      animation: none;
    }
  }

  @media (forced-colors: active) {
    :where(a[href], button, summary, input, select, textarea):focus-visible {
      box-shadow: none;
      outline-color: Highlight;
    }
  }

  body {
    font-family: "Inter Variable", sans-serif;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
</style>

<script>
  import { initializePortfolioTheme } from "../scripts/portfolioTheme";
  initializePortfolioTheme();
</script>



<script>
  const scratchCanvas = document.getElementById("canvas") as HTMLCanvasElement | null;
  if (scratchCanvas) {
  const canvas = scratchCanvas;
  const ctx = canvas.getContext("2d")!;
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  // Array to store particles
  let particles: Particle[] = [];

  class Particle {
    private x: number;
    private y: number;
    private size: number;
    private opacity: number;
    private life: number;
    private color: string;
    private darkMode: boolean;

    constructor(x: number, y: number) {
      this.x = x;
      this.y = y;
      this.size = Math.random() * 2 + 0.25; // Size of dust
      // size of dust could range from square to rectangle
      this.opacity = Math.random() * 0.5 + 0.1; // Opacity to make it look more realistic
      this.life = Math.random() * 10 + 5; // Shortened life duration of particles for quick flickering
      const darkMode = document.documentElement.classList.contains("dark");
      this.darkMode = darkMode;
      this.color = darkMode
        ? `rgba(255, 255, 255, ${this.opacity})`
        : `rgba(0, 0, 0, ${this.opacity})`;
    }

    draw() {
      ctx.fillStyle = this.color;
      const chanceForVerticalScratch = Math.random();
      let height = this.size;
      if (chanceForVerticalScratch > 0.99) {
        height = this.size * (Math.random() * 25 + 5);
      } else {
        height = this.size * (Math.random() * 2 + 1);
      }
      ctx.fillRect(this.x, this.y, this.size, height);
    }

    update() {
      this.life--;
      this.darkMode = document.documentElement.classList.contains("dark");
      this.color = this.darkMode
        ? `rgba(255, 255, 255, ${this.opacity})`
        : `rgba(0, 0, 0, ${this.opacity})`;

      if (this.life < 0) {
        this.respawn();
      }
    }

    respawn() {
      this.x = Math.random() * canvas.width;
      this.y = Math.random() * canvas.height;
      this.life = Math.random() * 10 + 5;
      this.opacity = Math.random() * 0.5 + 0.1;
    }
  }

  // Populate initial particles
  for (let i = 0; i < 15; i++) {
    particles.push(
      new Particle(Math.random() * canvas.width, Math.random() * canvas.height)
    );
  }

  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height); // Clear the canvas
    particles.forEach((particle) => {
      particle.update();
      particle.draw();
    });
    requestAnimationFrame(animate); // Loop the animation at roughly 60 FPS
  }

  animate();
  }
</script>
