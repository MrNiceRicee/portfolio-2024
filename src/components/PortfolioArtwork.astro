---
import artwork1x from "../assets/silly-guy/artwork-128.webp";
import artwork2x from "../assets/silly-guy/artwork-256.webp";
import artwork3x from "../assets/silly-guy/artwork-384.webp";
---

<div class="portfolio-artwork" aria-hidden="true">
  <img
    src={artwork1x.src}
    srcset={`${artwork1x.src} 1x, ${artwork2x.src} 2x, ${artwork3x.src} 3x`}
    alt=""
    width="128"
    height="128"
    decoding="async"
  />
</div>

<style>
  .portfolio-artwork {
    width: 128px;
    height: 128px;
    position: fixed;
    bottom: calc(var(--browser-edge-bottom, env(safe-area-inset-bottom, 0px)) - 1px);
    right: calc(env(safe-area-inset-right, 0px) - 16px);
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    z-index: 101;
  }
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 475px) {
    .portfolio-artwork {
      position: relative;
      bottom: 6px;
      right: 8px;
      margin-bottom: -18px;
      margin-left: 166px;
    }
  }
</style>
