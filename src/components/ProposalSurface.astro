---
import filmMaterial from "../assets/proposal-film.png";
import grain from "../assets/noise.svg";
---
<div class="proposal-decoration" aria-hidden="true">
  <div class="proposal-paper-fallback" style={`--fallback-material: url("${filmMaterial.src}")`}></div>
  <div class="proposal-paper" data-proposal-paper></div>
</div>
<div class="proposal-fibers" aria-hidden="true" style={`--fiber-grain: url("${grain.src}")`}></div>
<div class="proposal-film" data-proposal-film aria-hidden="true">
  <div class="grainy-light dark:grainy-dark proposal-grain"></div>
</div>
<canvas class="proposal-particles fixed inset-0 pointer-events-none z-[100] opacity-35 dark:opacity-25" data-proposal-particles aria-hidden="true"></canvas>
<div class="proposal-controls" data-type="metadata">
  <fieldset class="proposal-theme" data-theme-controls hidden>
    <legend>Theme</legend>
    <div class="proposal-theme-options">
      <label><input type="radio" name="portfolio-theme" value="light" /><span>Light</span></label>
      <label><input type="radio" name="portfolio-theme" value="dark" /><span>Dark</span></label>
      <label><input type="radio" name="portfolio-theme" value="system" checked /><span>System</span></label>
    </div>
  </fieldset>
  <button class="proposal-pause" type="button" data-pause-film hidden>Pause film</button>
</div>

<style is:global>
  html[data-proposal] {
    --proposal-paper: #fafaf9;
    --proposal-wash: #e8dfcc;
    --focus-surface: var(--proposal-paper);
  }
  html.dark[data-proposal] {
    --proposal-paper: #0c0a09;
    --proposal-wash: #302a21;
    --focus-surface: var(--proposal-paper);
  }
  html[data-proposal] body {
    position: relative;
    display: flow-root;
    isolation: isolate;
    background-color: var(--proposal-paper);
  }
  .proposal-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }
  .proposal-paper, .proposal-paper-fallback { position: absolute; inset: 0; }
  .proposal-paper { visibility: hidden; }
  .proposal-paper canvas { z-index: 0; }
  html[data-shader-status="ready"] .proposal-paper { visibility: visible; }
  html[data-shader-status="ready"] .proposal-paper-fallback { visibility: hidden; }
  /* an approximation for no JS or unavailable WebGL, not the Paper shader */
  .proposal-paper-fallback {
    background-image: linear-gradient(145deg, transparent 38%, #c5bcae55 40%, #ffffff40 42%, transparent 47%),
      linear-gradient(32deg, transparent 65%, #c5bcae66 67%, #ffffff55 69%, transparent 74%),
      var(--fallback-material);
    background-size: cover, cover, 768px 768px;
  }
  html[data-surface="fibers"] .proposal-paper-fallback {
    background-image: var(--fallback-material);
    background-size: 768px 768px;
  }
  html.dark[data-proposal] .proposal-paper-fallback { filter: invert(1); opacity: 0.2; }
  /* Stationary fibers and crease lighting share the document with the ink. */
  .proposal-fibers {
    position: absolute;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    background-image: linear-gradient(168deg, transparent 36%, #5b503e20 38%, #fff6 38.2%, transparent 40%),
      linear-gradient(22deg, transparent 71%, #5b503e18 72%, #fff5 72.15%, transparent 73%), var(--fiber-grain);
    background-size: 100% 100%, 100% 100%, 160px 160px;
    opacity: 0.12;
    mix-blend-mode: multiply;
  }
  html[data-surface="fibers"] .proposal-fibers {
    background-image: var(--fiber-grain);
    background-size: 160px 160px;
  }
  html.dark[data-proposal] .proposal-fibers { mix-blend-mode: screen; opacity: 0.08; }
  .proposal-film { position: fixed; inset: 0; pointer-events: none; z-index: 50; overflow: hidden; }
  html[data-proposal] .proposal-grain { animation-play-state: paused; }
  html[data-proposal][data-film-motion="running"] .proposal-grain { animation-play-state: running; }
  /* the static SVG remains available when fresh grain cannot run */
  html:is([data-film="quiet"], [data-film="used"]) .proposal-grain { animation: none; }
  html:is([data-film="quiet"], [data-film="used"])[data-film-motion="running"][data-reel-grain="ready"] .proposal-grain { visibility: hidden; }
  .proposal-particles { width: 100%; height: 100%; }
  .proposal-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px 24px;
    color: var(--focus-ink);
    max-width: 42rem;
    margin: 0 auto 24px;
    position: relative;
    z-index: 102;
  }
  .proposal-theme {
    margin: 0;
    padding: 0;
    min-width: 0;
    border: 0;
  }
  .proposal-theme legend { margin-bottom: 4px; }
  .proposal-theme-options { display: flex; flex-wrap: wrap; gap: 4px; }
  .proposal-theme label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 10px;
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: 2px;
  }
  .proposal-theme label:has(input:checked) { border-color: currentColor; }
  .proposal-theme input { margin: 0; accent-color: var(--focus-ink); }
  .proposal-theme label:has(input:focus-visible) {
    background-color: var(--proposal-wash);
    outline: 2px solid var(--focus-ink);
    outline-offset: 2px;
  }
  .proposal-theme input:focus-visible { outline: none; box-shadow: none; }
  .proposal-pause {
    position: relative;
    margin: 0;
    z-index: 102;
    padding: 8px 12px;
    min-height: 44px;
    font-size: 12px;
    color: var(--focus-ink);
    background: var(--proposal-paper);
    border: 1px solid currentColor;
    border-radius: 2px;
  }
  .proposal-pause[hidden], .proposal-theme[hidden] { display: none; }
  html[data-proposal][data-fallback] :is(.proposal-decoration, .proposal-fibers, .proposal-film, .proposal-particles) { display: none; }

  @media (prefers-reduced-motion: reduce) {
    html[data-proposal] :is(.proposal-grain, .proposal-film, .proposal-particles) { animation: none; }
    .proposal-particles { display: none; }
  }

  /* Every proposal retains the complete, immediate 2px edge. */
  html[data-proposal] :where(a[href], button, summary, input, select, textarea):focus-visible {
    transition: none;
    z-index: 102;
    box-shadow: none;
  }
  html[data-proposal][data-focus="b"] :where(a[href], button, summary, input, select, textarea):focus-visible {
    background-color: var(--proposal-wash);
    box-shadow: 0 0 0 3px var(--proposal-wash);
  }
  html[data-proposal][data-focus="c"] :where(a[href], button, summary, input, select, textarea):focus-visible {
    border-radius: 0;
    box-shadow: none;
  }
  html[data-proposal][data-focus="c"] :where(a[href], button, summary):focus-visible::after {
    content: "";
    position: absolute;
    width: 7px;
    height: 2px;
    top: -5px;
    right: -4px;
    background-color: var(--focus-ink);
    pointer-events: none;
  }
  @media (forced-colors: active) {
    .proposal-theme label:has(input:focus-visible) { outline-color: Highlight; }
    html[data-proposal] :where(a[href], button, summary, input, select, textarea):focus-visible {
      box-shadow: none;
      outline-color: Highlight;
    }
    .proposal-decoration, .proposal-fibers, .proposal-film, .proposal-particles, .proposal-pause { display: none; }
    html[data-proposal][data-focus="c"] :focus-visible::after { display: none; }
  }
</style>

<script>
  if (document.documentElement.hasAttribute("data-proposal")) {
    const lifetime = new AbortController();
    window.addEventListener("pagehide", (event) => {
      if (!event.persisted) lifetime.abort();
    }, { signal: lifetime.signal });
    import("../scripts/proposalRuntime").then(({ initializeProposalRuntime }) => {
      if (lifetime.signal.aborted) return;
      return initializeProposalRuntime(lifetime.signal);
    }).catch(() => {
      if (lifetime.signal.aborted) return;
      const root = document.documentElement;
      root.dataset.shaderStatus = "fallback";
      // entry-load failure has no film controller to publish the static state
      if (root.dataset.filmMotionReason === undefined) {
        root.dataset.filmMotion = "paused";
        root.dataset.filmMotionReason = "fallback";
        document.dispatchEvent(new Event("proposalfilmchange"));
      }
      document.dispatchEvent(new Event("proposalshaderchange"));
    });
  }
</script>
