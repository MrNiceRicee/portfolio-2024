---
import artwork from "../assets/silly-guy/eyes_open_mouth_closed.webp";
---
<div class="proposal-artwork" aria-hidden="true">
  <img src={artwork.src} alt="" width="128" height="128" />
</div>

<style>
  .proposal-artwork {
    width: 128px;
    height: 128px;
    position: fixed;
    bottom: -1px;
    right: -16px;
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    z-index: 101;
  }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 475px) {
    .proposal-artwork {
      position: relative;
      bottom: 6px;
      right: 8px;
      margin-bottom: -18px;
      margin-left: 166px;
    }
  }
</style>
