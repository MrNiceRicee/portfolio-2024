---
import filmMaterial from "../assets/paper-fibers.png";
import crinkleLight from "../assets/crumpled-paper-light.webp";
import crinkleDark from "../assets/crumpled-paper-dark.webp";
import grain from "../assets/noise.svg";
import AppearanceIcon from "./AppearanceIcon.astro";
import ChevronRight from "./icons/ChevronRight.astro";
---
<div class="portfolio-decoration" aria-hidden="true" data-paper-light={crinkleLight.src} data-paper-dark={crinkleDark.src} style={`--crinkle-light: url("${crinkleLight.src}"); --crinkle-dark: url("${crinkleDark.src}")`}>
  <div class="portfolio-paper-fallback" style={`--fallback-material: url("${filmMaterial.src}")`}></div>
  <div class="portfolio-paper" data-portfolio-paper></div>
</div>
<div class="portfolio-fibers" aria-hidden="true" style={`--fiber-grain: url("${grain.src}")`}></div>
<div class="portfolio-film" data-portfolio-film aria-hidden="true">
  <div class="grainy-light dark:grainy-dark portfolio-grain"></div>
</div>
<canvas class="portfolio-particles fixed inset-0 pointer-events-none z-[100] opacity-35 dark:opacity-25" data-portfolio-particles aria-hidden="true"></canvas>
<div class="portfolio-controls" data-type="metadata">
  <div class="portfolio-appearance" data-theme-controls data-preference="system" data-open="false" hidden>
    <button class="portfolio-appearance-trigger" id="appearance-trigger" type="button" data-theme-trigger aria-label="Appearance: System" aria-haspopup="menu" aria-controls="appearance-menu" aria-expanded="false">
      <span class="portfolio-appearance-current-icon" aria-hidden="true">
        {(["light", "dark", "system"] as const).map((kind) => (
          <span class="portfolio-appearance-trigger-art" data-theme-trigger-art={kind}>
            <AppearanceIcon id={`appearance-trigger-${kind}`} kind={kind} state={kind === "system" ? "active" : "idle"} />
          </span>
        ))}
      </span>
      <span data-theme-label>System</span>
      <ChevronRight class="portfolio-appearance-chevron" />
    </button>
    <div class="portfolio-appearance-menu" id="appearance-menu" data-theme-menu role="menu" aria-labelledby="appearance-trigger" hidden>
      <div class="portfolio-appearance-heading" aria-hidden="true">Appearance</div>
      {(["light", "dark", "system"] as const).map((preference) => (
        <button type="button" class="portfolio-appearance-option" role="menuitemradio" data-theme-choice={preference} aria-checked={preference === "system"} tabindex="-1">
          <AppearanceIcon id={`appearance-menu-${preference}`} kind={preference} state={preference === "system" ? "active" : "idle"} />
          <span>{preference.charAt(0).toUpperCase() + preference.slice(1)}</span>
          <svg class="portfolio-appearance-check" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4 10-10" /></svg>
        </button>
      ))}
    </div>
  </div>
  <button class="portfolio-pause" type="button" data-pause-film hidden>Pause film</button>
</div>

<style is:global>
  html[data-portfolio] {
    --paper-surface: #fafaf9;
    --focus-wash: #e8dfcc;
    --focus-surface: var(--paper-surface);
  }
  html.dark[data-portfolio] {
    --paper-surface: #0c0a09;
    --focus-wash: #302a21;
    --focus-surface: var(--paper-surface);
  }
  html[data-portfolio] body {
    position: relative;
    display: flow-root;
    isolation: isolate;
    background-color: var(--paper-surface);
  }
  .portfolio-decoration {
    --crinkle-intensity: 0.3;
    --crinkle-size: 940.604061px;
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }
  /* Cached reference relief stays static during scrolling and theme changes. */
  html[data-portfolio] .portfolio-decoration::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--crinkle-light) repeat center / var(--crinkle-size, 768px) var(--crinkle-size, 768px);
    opacity: var(--crinkle-intensity);
  }
  html.dark .portfolio-decoration { --crinkle-intensity: 0.4; --crinkle-size: 1330.21502px; }
  html.dark[data-portfolio] .portfolio-decoration::after {
    background-image: var(--crinkle-dark);
    opacity: calc(var(--crinkle-intensity) * 0.34);
  }
  .portfolio-paper, .portfolio-paper-fallback { position: absolute; inset: 0; }
  .portfolio-paper { visibility: hidden; }
  .portfolio-paper canvas { z-index: 0; }
  html[data-shader-status="ready"] .portfolio-paper { visibility: visible; }
  html[data-shader-status="ready"] .portfolio-paper-fallback { visibility: hidden; }
  /* an approximation for no JS or unavailable WebGL, not the Paper shader */
  .portfolio-paper-fallback {
    background-image: var(--fallback-material);
    background-size: 768px 768px;
  }
  html.dark[data-portfolio] .portfolio-paper-fallback { filter: invert(1); opacity: 0.2; }
  /* dark-mode stationary grain */
  .portfolio-fibers {
    position: absolute;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    background-image: var(--fiber-grain);
    background-size: 160px 160px;
    opacity: 0;
    mix-blend-mode: multiply;
  }
  html.dark[data-portfolio] .portfolio-fibers { mix-blend-mode: screen; opacity: 0.08; }
  .portfolio-film { position: fixed; inset: 0; pointer-events: none; z-index: 50; overflow: hidden; }
  html[data-portfolio] .portfolio-grain { animation-play-state: paused; }
  html[data-portfolio][data-film-motion="running"] .portfolio-grain { animation-play-state: running; }
  .portfolio-particles { width: 100%; height: 100%; }
  .portfolio-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px 24px;
    color: var(--focus-ink);
    max-width: 42rem;
    margin: 0 auto 24px;
    position: relative;
    z-index: 102;
  }
  .portfolio-appearance { position: relative; min-width: 0; }
  .portfolio-appearance-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 10px;
    color: inherit;
    background: var(--paper-surface);
    border: 1px solid currentColor;
    border-radius: 2px;
    cursor: pointer;
  }
  .portfolio-appearance [data-theme-label] { min-width: 6ch; text-align: left; }
  .portfolio-appearance-current-icon { display: inline-grid; width: 22px; height: 22px; }
  .portfolio-appearance-trigger-art { grid-area: 1 / 1; display: inline-grid; visibility: hidden; }
  .portfolio-appearance[data-preference="light"] [data-theme-trigger-art="light"],
  .portfolio-appearance[data-preference="dark"] [data-theme-trigger-art="dark"],
  .portfolio-appearance[data-preference="system"] [data-theme-trigger-art="system"] { visibility: visible; }
  .portfolio-appearance-chevron { width: 14px; height: 14px; transform: rotate(-90deg); }
  .portfolio-appearance[data-open="true"] .portfolio-appearance-chevron { transform: rotate(90deg); }
  .portfolio-appearance-menu {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    width: min(224px, calc(100vw - 48px));
    box-sizing: border-box;
    padding: 6px;
    background: var(--paper-surface);
    border: 1px solid color-mix(in srgb, currentColor 24%, transparent);
    border-radius: 3px;
    box-shadow: 0 5px 16px #00000014;
    transform-origin: bottom left;
    opacity: 0;
    transform: translateY(4px) scale(0.98);
    visibility: hidden;
    pointer-events: none;
  }
  html.dark .portfolio-appearance-menu { box-shadow: 0 5px 16px #00000040; }
  .portfolio-appearance[data-open="true"] .portfolio-appearance-menu { opacity: 1; transform: translateY(0) scale(1); visibility: visible; pointer-events: auto; }
  .portfolio-appearance-heading { padding: 7px 10px 8px; font-size: 12px; letter-spacing: 0.04em; }
  .portfolio-appearance-option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 44px;
    padding: 8px 10px;
    border: 0;
    border-radius: 2px;
    color: inherit;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .portfolio-appearance-option[aria-checked="true"] { background: color-mix(in srgb, currentColor 6%, var(--paper-surface)); }
  .portfolio-appearance[data-interaction="pointer"] .portfolio-appearance-trigger:active { transform: scale(0.98); }
  .portfolio-appearance-check { margin-left: auto; opacity: 0; }
  .portfolio-appearance-option[aria-checked="true"] .portfolio-appearance-check { opacity: 1; }
  .portfolio-appearance[data-interaction="pointer"] :is(.portfolio-appearance-chevron, .portfolio-appearance-trigger) { transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), opacity 160ms cubic-bezier(0.16, 1, 0.3, 1); }
  .portfolio-appearance[data-interaction="pointer"] .portfolio-appearance-menu { transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), opacity 160ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s 160ms; }
  .portfolio-appearance[data-interaction="pointer"][data-open="true"] .portfolio-appearance-menu { transition-delay: 0s; }
  @media (hover: hover) and (pointer: fine) {
    .portfolio-appearance-trigger:hover, .portfolio-appearance-option:hover { background: color-mix(in srgb, currentColor 9%, var(--paper-surface)); }
  }
  .portfolio-pause {
    position: relative;
    margin: 0;
    z-index: 102;
    padding: 8px 12px;
    min-height: 44px;
    font-size: 12px;
    color: var(--focus-ink);
    background: var(--paper-surface);
    border: 1px solid currentColor;
    border-radius: 2px;
  }
  .portfolio-pause[hidden], .portfolio-appearance[hidden], .portfolio-appearance-menu[hidden] { display: none; }

  @media (prefers-reduced-motion: reduce) {
    html[data-portfolio] :is(.portfolio-grain, .portfolio-film, .portfolio-particles) { animation: none; }
    .portfolio-particles { display: none; }
    .portfolio-appearance :is(.portfolio-appearance-chevron, .portfolio-appearance-trigger, .portfolio-appearance-menu) { transition: none !important; }
  }

  /* keep the complete, immediate 2px edge and warm wash */
  html[data-portfolio] :where(a[href], button, summary, input, select, textarea):focus-visible {
    transition: none;
    z-index: 102;
    background-color: var(--focus-wash);
    box-shadow: 0 0 0 3px var(--focus-wash);
  }
  @media (forced-colors: active) {
    .portfolio-appearance-option[aria-checked="true"] { outline: 1px solid SelectedItem; }
    html[data-portfolio] :where(a[href], button, summary, input, select, textarea):focus-visible {
      box-shadow: none;
      outline-color: Highlight;
    }
    .portfolio-decoration, .portfolio-fibers, .portfolio-film, .portfolio-particles, .portfolio-pause { display: none; }
  }
</style>

<script>
  import { initializeReferencePaper } from "../scripts/referencePaper";
  const root = document.documentElement;
  initializeReferencePaper();
  if (root.hasAttribute("data-portfolio")) {
    const lifetime = new AbortController();
    window.addEventListener("pagehide", (event) => {
      if (!event.persisted) lifetime.abort();
    }, { signal: lifetime.signal });
    import("../scripts/portfolioRuntime").then(({ initializePortfolioRuntime }) => {
      if (lifetime.signal.aborted) return;
      return initializePortfolioRuntime(lifetime.signal);
    }).catch((error) => {
      if (lifetime.signal.aborted) return;
      root.dataset.shaderFailure = "runtime-initialization";
      console.warn("[Portfolio paper] Runtime initialization failed", error);
      root.dataset.shaderStatus = "fallback";
      root.dataset.filmMotion = "paused";
      document.dispatchEvent(new Event("portfolioshaderchange"));
    });
  }
</script>
