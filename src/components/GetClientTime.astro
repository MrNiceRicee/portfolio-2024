---
import { lastUpdated } from "../constants/lastUpdated";
---

<p>
  last updated on
  <time class="tabular-nums" datetime={lastUpdated} data-client-time
    >{new Date(lastUpdated).toUTCString()}</time
  >
</p>

<script>
  const formatter = new Intl.DateTimeFormat(undefined, {
    year: "numeric",
    month: "long",
    day: "numeric",
    hour: "numeric",
    minute: "numeric",
    second: "numeric",
  });

  document.querySelectorAll<HTMLTimeElement>("time[data-client-time]").forEach((time) => {
    time.textContent = formatter.format(new Date(time.dateTime));
  });
</script>
