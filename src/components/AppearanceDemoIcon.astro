---
interface Props {
  kind: "light" | "dark" | "system";
  state?: "idle" | "active";
  size?: number;
  fixed?: boolean;
}
const { kind, state = "idle", size = 22, fixed = false } = Astro.props;
---

<!-- exact lucide svg children; sources and retained licenses: /third-party/appearance-icons/NOTICE -->
<span class="appearance-art" data-demo-icon={kind} data-state={state} data-fixed={fixed ? "true" : undefined} style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg data-art-layer="idle" focusable="false" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {kind === "light" && <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 3v1" />
      <path d="M12 20v1" />
      <path d="M3 12h1" />
      <path d="M20 12h1" />
      <path d="m18.364 5.636-.707.707" />
      <path d="m6.343 17.657-.707.707" />
      <path d="m5.636 5.636.707.707" />
      <path d="m17.657 17.657.707.707" />
    </>}
    {kind === "dark" && <>
      <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
    </>}
    {kind === "system" && <>
      <rect width="20" height="14" x="2" y="3" rx="2" />
      <line x1="8" x2="16" y1="21" y2="21" />
      <line x1="12" x2="12" y1="17" y2="21" />
    </>}
  </svg>
  <svg data-art-layer="active" focusable="false" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {kind === "light" && <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2" />
      <path d="M12 20v2" />
      <path d="m4.93 4.93 1.41 1.41" />
      <path d="m17.66 17.66 1.41 1.41" />
      <path d="M2 12h2" />
      <path d="M20 12h2" />
      <path d="m6.34 17.66-1.41 1.41" />
      <path d="m19.07 4.93-1.41 1.41" />
    </>}
    {kind === "dark" && <>
      <path d="M18 5h4" />
      <path d="M20 3v4" />
      <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
    </>}
    {kind === "system" && <>
      <path d="M12 17v4" />
      <path d="m14.305 7.53.923-.382" />
      <path d="m15.228 4.852-.923-.383" />
      <path d="m16.852 3.228-.383-.924" />
      <path d="m16.852 8.772-.383.923" />
      <path d="m19.148 3.228.383-.924" />
      <path d="m19.53 9.696-.382-.924" />
      <path d="m20.772 4.852.924-.383" />
      <path d="m20.772 7.148.924.383" />
      <path d="M22 13v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7" />
      <path d="M8 21h8" />
      <circle cx="18" cy="6" r="3" />
    </>}
  </svg>
</span>

<style>
  .appearance-art { display: inline-grid; place-items: center; flex: none; vertical-align: middle; }
  svg { grid-column: 1; grid-row: 1; overflow: visible; transform-origin: center; transition: transform 280ms cubic-bezier(0.45, 0, 0.55, 1), opacity 280ms cubic-bezier(0.45, 0, 0.55, 1); }
  [data-art-layer="idle"] { opacity: 1; transform: rotate(0deg) scale(1); }
  [data-art-layer="active"] { opacity: 0; transform: rotate(-45deg) scale(0.9); }
  [data-state="active"] [data-art-layer="idle"] { opacity: 0; transform: rotate(45deg) scale(0.9); }
  [data-state="active"] [data-art-layer="active"] { opacity: 1; transform: rotate(0deg) scale(1); }
  [data-fixed="true"] svg,
  [data-instant="true"] svg,
  :global([data-demo-controls][data-interaction="keyboard"]) svg { transition: none; transform: none; }
  @media (prefers-reduced-motion: reduce) { svg { transition: none; transform: none !important; } }
</style>
