---
interface Props {
  kind: "light" | "dark" | "system";
  state?: "idle" | "active";
  size?: number;
  fixed?: boolean;
}
const { kind, state = "idle", size = 22, fixed = false } = Astro.props;
---

<span class="appearance-art" data-demo-icon={kind} data-state={state} data-fixed={fixed ? "true" : undefined} style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg data-art-layer="idle" focusable="false" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {kind === "light" && <><path d="M5 15a7 7 0 0 1 14 0M3 15h18M6 19h12M8 11l1.5 1 1.5-1m2 0 1.5 1 1.5-1" /></>}
    {kind === "dark" && <path d="M19.8 14.1A8.5 8.5 0 0 1 10 4a8.5 8.5 0 1 0 9.8 10.1Z" />}
    {kind === "system" && <><rect x="3" y="4" width="18" height="13" rx="1" /><path d="M8 21h8m-4-4v4M8 10l2 1 2-1m3 4h2" /></>}
  </svg>
  <svg data-art-layer="active" focusable="false" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {kind === "light" && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></>}
    {kind === "dark" && <><path d="M16 14.5A7 7 0 0 1 9.5 4a7.5 7.5 0 1 0 6.5 10.5Z" /><path d="m17.5 2 1 2.5L21 5.5l-2.5 1L17.5 9l-1-2.5-2.5-1 2.5-1Z" /><path d="M20.5 11v3m-1.5-1.5h3" /></>}
    {kind === "system" && <><rect x="3" y="4" width="18" height="13" rx="1" /><path d="M12 4h8a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-8Z" fill="currentColor" stroke="none" /><circle cx="7.5" cy="10.5" r="1.5" /><path d="M8 21h8m-4-4v4M12 5v11" /><path d="M17 8v5" stroke="var(--demo-surface)" /></>}
  </svg>
</span>

<style>
  .appearance-art { display: inline-block; position: relative; flex: none; vertical-align: middle; }
  svg { position: absolute; inset: 0; overflow: visible; transition: transform 240ms cubic-bezier(0.19, 1, 0.22, 1), opacity 240ms cubic-bezier(0.19, 1, 0.22, 1); }
  [data-art-layer="idle"] { opacity: 1; transform: translateY(0); }
  [data-art-layer="active"] { opacity: 0; transform: translateY(4px); }
  [data-state="active"] [data-art-layer="idle"] { opacity: 0; transform: translateY(-4px); }
  [data-state="active"] [data-art-layer="active"] { opacity: 1; transform: translateY(0); }
  [data-fixed="true"] svg,
  [data-instant="true"] svg,
  :global([data-demo-controls][data-interaction="keyboard"]) svg { transition: none; transform: none; }
  @media (prefers-reduced-motion: reduce) { svg { transition: none; transform: none !important; } }
</style>
