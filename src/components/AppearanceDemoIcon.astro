---
interface Props {
  id: string;
  kind: "light" | "dark" | "system";
  moonVariant?: "cloud" | "full";
  state?: "idle" | "active";
  size?: number;
  fixed?: boolean;
}
const { id, kind, moonVariant = "cloud", state = "idle", size = 22, fixed = false } = Astro.props;
const moonMask = `${id}-moon-mask`;
const moonClip = `${id}-moon-clip`;
const cloudClip = `${id}-cloud-clip`;
const rays = ["M12 4V2", "M12 20v2", "m6.34 6.34-1.41-1.41", "m17.66 17.66 1.41 1.41", "M4 12H2", "M20 12h2", "m6.34 17.66-1.41 1.41", "m17.66 6.34 1.41-1.41"];
---

<!-- adapted lucide geometry; sources and retained licenses: /third-party/appearance-icons/NOTICE -->
<span class="appearance-art" data-demo-icon={kind} data-moon-variant={kind === "dark" ? moonVariant : undefined} data-state={state} data-device-theme={kind === "system" ? "light" : undefined} data-fixed={fixed ? "true" : undefined} style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg focusable="false" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {kind === "light" && <>
      <circle cx="12" cy="12" r="4" />
      {rays.map((d) => <path data-motion-part="sun-ray" d={d} pathLength="1" />)}
    </>}
    {kind === "dark" && moonVariant === "cloud" && <>
      <defs><clipPath id={cloudClip}><rect width="24" height="24" /></clipPath></defs>
      <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
      <g clip-path={`url(#${cloudClip})`}>
        <path data-motion-part="cloud" d="M14.75 22H10.5a3.5 3.5 0 1 1 3.355-4.5h.895a2.25 2.25 0 1 1 0 4.5Z" fill="currentColor" stroke-width="1.5" />
      </g>
    </>}
    {kind === "dark" && moonVariant === "full" && <>
      <defs>
        <mask id={moonMask} maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
          <rect width="24" height="24" fill="white" stroke="none" />
          <circle data-motion-part="moon-cutout" cx="16" cy="8" r="8" fill="black" stroke="none" />
        </mask>
        <clipPath id={moonClip}><circle cx="12" cy="12" r="9" /></clipPath>
      </defs>
      <circle cx="12" cy="12" r="9" mask={`url(#${moonMask})`} />
      <g clip-path={`url(#${moonClip})`}>
        <circle data-motion-part="moon-cutout" cx="16" cy="8" r="8" />
      </g>
    </>}
    {kind === "system" && <>
      <rect data-motion-part="screen" width="16" height="10" x="4" y="5" rx="0.5" stroke="none" />
      <rect width="20" height="14" x="2" y="3" rx="2" />
      <line x1="8" x2="16" y1="21" y2="21" />
      <line x1="12" x2="12" y1="17" y2="21" />
    </>}
  </svg>
</span>

<style>
  .appearance-art { display: inline-grid; place-items: center; flex: none; vertical-align: middle; }
  svg { grid-column: 1; grid-row: 1; overflow: visible; }
  [data-motion-part] { transition-duration: 280ms; transition-timing-function: cubic-bezier(0.45, 0, 0.55, 1); }
  [data-motion-part="sun-ray"] { stroke-dasharray: 1 1; stroke-dashoffset: 0.5; transition-property: stroke-dashoffset; }
  [data-state="active"] [data-motion-part="sun-ray"] { stroke-dashoffset: 0; }
  [data-motion-part="cloud"] { transform: translateX(0); transition-property: transform; }
  [data-state="active"] [data-motion-part="cloud"] { transform: translateX(20px); }
  [data-motion-part="moon-cutout"] { transform: translate(0, 0); transition-property: transform; }
  [data-state="active"] [data-motion-part="moon-cutout"] { transform: translate(12px, -12px); }
  [data-motion-part="screen"] { fill: #292524; transition-property: fill; }
  [data-device-theme="light"][data-state="active"] [data-motion-part="screen"],
  [data-device-theme="dark"][data-state="idle"] [data-motion-part="screen"] { fill: #e7e5e4; }
  [data-fixed="true"] [data-motion-part],
  [data-instant="true"] [data-motion-part],
  :global([data-demo-controls][data-interaction="keyboard"]) [data-motion-part] { transition: none; }
  @media (prefers-reduced-motion: reduce) { [data-motion-part] { transition: none; } }
</style>
