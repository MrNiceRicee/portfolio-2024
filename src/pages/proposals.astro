---
import PortfolioTypography from "../components/PortfolioTypography.astro";
---
<!doctype html>
<html lang="en" data-proposal>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The chosen portfolio design." />
    <title>Chosen design · Josh's corner</title>
    <PortfolioTypography />
    <script is:inline>
      document.documentElement.classList.toggle("dark", window.matchMedia("(prefers-color-scheme: dark)").matches);
    </script>
  </head>
  <body>
    <main>
      <h1 data-type="name">Chosen design</h1>
      <p data-type="prose">Fibers only / Original film / Field manual</p>
      <nav aria-label="View the chosen portfolio">
        <a href="/">Open portfolio</a>
        <a href="/?theme=light">Light theme</a>
        <a href="/?theme=dark">Dark theme</a>
        <a href="/?fallback=1">Plain surface</a>
      </nav>
    </main>
  </body>
</html>
<style>
  body { margin: 0; background: #f4f0e6; }
  :global(html.dark) body { background: #191713; }
  main { max-width: 65ch; margin: 0 auto; padding: 48px 24px; }
  p { margin-block: 24px; }
  nav { display: flex; flex-wrap: wrap; gap: 16px 24px; }
  a { color: inherit; min-height: 44px; display: inline-flex; align-items: center; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
</style>
