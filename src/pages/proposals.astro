---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import { getProposalConfig, paperVariants, filmVariants } from "../scripts/proposalConfig";
const config = getProposalConfig(Astro.url);
const viewport = Astro.url.searchParams.get("viewport") === "phone" ? "phone" : "full";
const parameters = new URLSearchParams({ proposal: "1", focus: "b", surface: config.surface, film: config.film, theme: config.theme });
if (config.fallback) parameters.set("fallback", "1");
const previewUrl = `/?${parameters}`;
const surfaceNotes = paperVariants[config.surface].description;
const filmNotes = filmVariants[config.film].description;
const typeSamples = [
  { key: "reference", label: "Current reference", note: "Restored bundled JetBrains Mono; existing size and weight hierarchy." },
  { key: "mono", label: "01 / Terminal editorial", note: "Same JetBrains Mono, with a larger name, stronger section hierarchy and comfortable reading rhythm." },
  { key: "technical", label: "02 / Technical manual", note: "Bold Inter headings, readable Inter body and restrained JetBrains labels. Hardware-manual hierarchy without pixel text." },
];
const typeIntro = "I am a fullstack developer with a passion for building, learning and collaborating with others. Started my journey in coding when I was 10 years old, writing in Lua and making games in Roblox.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Original film, on paper — design study</title>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">Josh’s corner / Design study 01</p>
        <h1>Original film, on paper</h1>
        <div class="intro">
          <p>A paper surface that follows the words, with film choices over it. Compare paper and film independently, with the selected Editorial focus wash.</p>
          <p class="recommendation"><strong>Shared surface, your choice of film.</strong> Paper stays with the text; film moves over it. Keep the baseline creases or choose fibers only. The original character stays clear.</p>
        </div>
      </header>

      <form method="get" action="/proposals" aria-label="Adjust preview view">
        <div class="choices">
          <input type="hidden" name="focus" value="b" />
          <label>Paper
            <select name="surface">
              {Object.entries(paperVariants).map(([value, variant]) => <option value={value} selected={config.surface === value}>{variant.label}</option>)}
            </select>
          </label>
          <label>Film
            <select name="film">
              {Object.entries(filmVariants).map(([value, variant]) => <option value={value} selected={config.film === value}>{variant.label}</option>)}
            </select>
          </label>
          <label>Theme
            <select name="theme">
              <option value="light" selected={config.theme === "light"}>Light paper</option>
              <option value="dark" selected={config.theme === "dark"}>Dark paper</option>
            </select>
          </label>
          <label>View
            <select name="viewport">
              <option value="full" selected={viewport === "full"}>Full width</option>
              <option value="phone" selected={viewport === "phone"}>Phone · 390px</option>
            </select>
          </label>
        </div>
        <div class="form-actions">
          <button type="submit">Apply view <span aria-hidden="true">↗</span></button>
          <label class="fallback"><input type="checkbox" name="fallback" value="1" checked={config.fallback} /> Plain surface</label>
          <a href={previewUrl} target="_blank" rel="noopener">Open this version <span class="sr-only">in a new tab</span><span aria-hidden="true">↗</span></a>
        </div>
      </form>

      <section class="selection" aria-label="Selected proposal">
        <p>Editorial B · The selected wash, with the same complete 2px keyline.</p>
        <p>{surfaceNotes}</p>
        <p>{filmNotes} Grain strength, tiling and cadence stay the same across film options.</p>
      </section>
      <section aria-label="Live portfolio comparison">
        <div class="preview-caption">
          <p>Live portfolio · {viewport === "phone" ? "390px, or available width" : "available width"}</p>
          <button class="try-focus" type="button" data-try-focus>Try keyboard focus ↓</button>
        </div>
        <div class:list={["preview", { phone: viewport === "phone" }]}>
          <iframe id="portfolio-preview" title={`Portfolio preview: Editorial B, ${config.surface}, ${config.film}, ${config.theme}`} src={previewUrl} width="960" height="820"></iframe>
        </div>
        <p class="film-status" data-film-status role="status">Film status unavailable · Preview loading or JavaScript disabled.</p>
        <p class="try-it">Tab into the preview, or activate “Try keyboard focus” with Enter. Use ↑ / ↓ between experience headings, Enter to open, and Escape to tuck revealed spoilers away. Use “Pause film” inside the preview to stop the grain and scratches.</p>
      </section>

      <section class="type-study" data-theme={config.theme} aria-labelledby="type-study-title">
        <h2 id="type-study-title">Type / a quieter retro future</h2>
        <p class="type-study-intro">Same words, three hierarchies. These samples leave the portfolio above unchanged. Compare the early terminal feel with a technical-manual direction. Both reuse the fonts already bundled with the site.</p>
        {typeSamples.map((sample) => (
          <article class="type-row" aria-labelledby={`type-${sample.key}`}>
            <header class="type-note">
              <h3 id={`type-${sample.key}`}>{sample.label}</h3>
              <p>{sample.note}</p>
            </header>
            <div class={`type-excerpt type-${sample.key}`}>
              <h4 class="type-name">Joshua Constantine Santos</h4>
              <p class="type-role">Fullstack developer</p>
              <h5 class="type-section">Who am I</h5>
              <p class="type-body">{typeIntro}</p>
              <h5 class="type-experience">Senior fullstack engineer, MedBridge</h5>
              <p class="type-dates">March 2026 - Present</p>
            </div>
          </article>
        ))}
      </section>

      <details class="review-notes">
        <summary>About this study</summary>
        <p>This is a review-only, throwaway proposal, using the actual portfolio content and interactions. Editorial B keeps a complete, immediate 2px keyline. Paper Texture and stationary fibers follow the document; the fibers-only option removes crease shading. The selected film passes over native HTML text; gate weave shifts only the effect layer. The character and focused control stay clear above them.</p>
        <p>Paper Shaders 0.0.81 renders the stationary paper with a 600,000-pixel target. “Pause film” stops the grain and scratches. Reduced motion keeps stationary paper and grain, with no particles. Motion pauses when the document is hidden or the preview is offscreen. Without JavaScript, WebGL or a working shader, a static CSS paper approximation remains. Plain surface removes all background decoration.</p>
        <p><a href="https://shaders.paper.design/paper-texture" target="_blank" rel="noopener">Paper Texture</a> · <a href="https://github.com/paper-design/shaders" target="_blank" rel="noopener">Paper Shaders</a> · <a href="/third-party/paper-shaders/LICENSE">Apache 2.0 license</a> · <a href="/third-party/paper-shaders/NOTICE">Notice</a></p>
      </details>
      <footer><span>Small changes, viewed in context.</span><a href="/">Current portfolio ↗</a></footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f4f0e6; color: #3c342e; font-family: "Inter Variable", sans-serif; }
  main { max-width: 1088px; margin: auto; padding: 48px 32px 28px; }
  .eyebrow, .preview-caption, label, footer { font-family: "JetBrains Mono Variable", monospace; }
  .eyebrow { font-size: 11px; letter-spacing: 0.09em; text-transform: uppercase; margin: 0; color: #6f6257; }
  h1 { font-size: clamp(36px, 5vw, 64px); line-height: 1.05; letter-spacing: -0.055em; font-weight: 550; margin: 18px 0 24px; }
  .intro { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding-bottom: 28px; }
  .intro p { margin: 0; line-height: 1.65; font-size: 15px; max-width: 45ch; }
  .recommendation { color: #6b5745; }
  .recommendation strong { color: #3c342e; font-weight: 600; }
  form { border-block: 1px solid #c7baa6; padding-block: 24px; }
  .choices { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  label { font-size: 11px; display: flex; flex-direction: column; gap: 8px; }
  select { appearance: auto; width: 100%; min-height: 44px; border: 1px solid #baad98; border-radius: 2px; background: #faf7ef; color: #3c342e; padding: 8px 28px 8px 10px; font-family: "Inter Variable", sans-serif; font-size: 13px; }
  .form-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 20px; }
  button { min-height: 44px; background: #514337; color: #faf4e8; border: 1px solid #514337; border-radius: 2px; padding: 10px 16px; cursor: pointer; font: 500 13px "Inter Variable", sans-serif; }
  button span { margin-left: 16px; }
  .fallback { flex-direction: row; align-items: center; gap: 8px; min-height: 44px; font-size: 12px; cursor: pointer; }
  input { accent-color: #665346; width: 17px; height: 17px; }
  a { color: inherit; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .form-actions a { margin-left: auto; font-size: 13px; padding-block: 12px; }
  .form-actions a > span:last-child { margin-left: 6px; }
  .selection { padding-block: 20px 28px; }
  .selection p { margin: 0 0 8px; font-size: 13px; color: #6f6257; line-height: 1.6; }
  .selection p:first-child { color: #3c342e; font-weight: 550; }
  .preview-caption { display: flex; justify-content: space-between; gap: 16px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; color: #6f6257; margin-bottom: 10px; }
  .preview-caption p { margin: 0; }
  .try-focus { color: #514337; background: transparent; border: 0; padding: 0 0 6px; min-height: 24px; font: inherit; text-transform: uppercase; text-decoration: underline; text-underline-offset: 4px; }
  .preview { border: 1px solid #b9aa94; background: #e9e0cf; width: 100%; margin-inline: auto; }
  .preview.phone { width: min(390px, 100%); }
  iframe { display: block; width: 100%; height: 820px; border: 0; background: #f4f0e6; }
  .try-it { color: #6f6257; font-size: 12px; line-height: 1.7; margin: 14px 0 32px; max-width: 85ch; }
  .film-status { color: #514337; font-size: 12px; line-height: 1.7; margin: 14px 0 0; }
  .review-notes { padding-bottom: 24px; font-size: 12px; line-height: 1.7; color: #6f6257; max-width: 80ch; }
  summary { min-height: 44px; display: list-item; cursor: pointer; padding-block: 10px; }
  footer { border-top: 1px solid #c7baa6; display: flex; justify-content: space-between; gap: 16px; padding-top: 24px; font-size: 10px; color: #6f6257; }
  :where(a, button, input, select, summary):focus-visible { outline: 2px solid #665346; outline-offset: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 720px) {
    main { padding: 32px 20px 24px; }
    .intro { grid-template-columns: 1fr; gap: 16px; }
    .form-actions { gap: 12px 20px; }
    .form-actions a { margin-left: 0; }
    iframe { height: 720px; }
  }
  @media (max-width: 390px) {
    main { padding-inline: 16px; }
    .choices { grid-template-columns: 1fr; }
  }

  .type-study { margin-block: 2rem; color: #3c342e; background: #f4f0e6; }
  .type-study[data-theme="dark"] { color: #e8dfcc; background: #191713; }
  .type-study > h2 { margin: 0 0 1rem; font-size: 1.5rem; line-height: 1.25; font-weight: 650; letter-spacing: -0.025em; }
  .type-study-intro { font-size: 1rem; line-height: 1.6; max-width: 65ch; margin: 0 0 2rem; }
  .type-row { display: grid; grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr); gap: 2rem; padding-block: 2rem; border-top: 1px solid currentColor; }
  .type-note h3 { font-size: 1rem; line-height: 1.4; font-weight: 600; margin: 0 0 0.75rem; }
  .type-note p { font-size: 1rem; line-height: 1.6; margin: 0; }
  .type-excerpt { min-width: 0; font-family: "JetBrains Mono Variable", ui-monospace, monospace; font-kerning: normal; }
  .type-excerpt :is(h4, h5, p) { margin: 0; }
  .type-name { font-size: 1rem; line-height: 1.5; font-weight: 700; overflow-wrap: anywhere; }
  .type-role { font-size: 1.25rem; line-height: 1.2; letter-spacing: 0.04rem; }
  .type-section { margin-top: 2rem !important; margin-bottom: 0.5rem !important; font-size: 1.125rem; line-height: 1.55; font-weight: 500; }
  .type-body { font-size: 1rem; line-height: 1.6; max-width: 65ch; }
  .type-experience { margin-top: 2rem !important; font-size: 1rem; line-height: 1.5; font-weight: 500; }
  .type-dates { margin-top: 0.25rem !important; font-size: 1rem; line-height: 1.5; font-variant-numeric: tabular-nums; }
  .type-reference { font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
  .type-reference .type-role { font-weight: 500; line-height: 1; }
  .type-mono .type-name { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; letter-spacing: -0.035em; }
  .type-mono .type-role { margin-top: 0.5rem; font-size: 1rem; line-height: 1.5; letter-spacing: 0; }
  .type-mono .type-section { font-size: 1.25rem; line-height: 1.3; font-weight: 700; }
  .type-mono .type-experience { font-weight: 600; }
  .type-technical { font-family: "Inter Variable", system-ui, sans-serif; }
  .type-technical .type-name { font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1; letter-spacing: -0.04em; font-weight: 750; }
  .type-technical :is(.type-role, .type-dates) { font-family: "JetBrains Mono Variable", ui-monospace, monospace; font-size: 1rem; letter-spacing: 0; line-height: 1.5; }
  .type-technical .type-role { margin-top: 0.75rem; }
  .type-technical .type-section { font-size: 1.5rem; line-height: 1.2; font-weight: 700; letter-spacing: -0.025em; }
  .type-technical .type-experience { font-size: 1.25rem; line-height: 1.3; font-weight: 650; letter-spacing: -0.015em; }
  .type-study[data-theme="dark"] :is(.type-body, .type-note p, .type-study-intro) { line-height: 1.7; }
  @media (max-width: 720px) { .type-row { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; } }

</style>

<script>
  import { getProposalFilmStatus } from "../scripts/proposalConfig";

  const preview = document.querySelector<HTMLIFrameElement>("#portfolio-preview");
  const status = document.querySelector<HTMLElement>("[data-film-status]");
  const lifecycle = new AbortController();
  const options = { signal: lifecycle.signal };
  let previewListeners: AbortController | undefined;
  const bindFilmStatus = () => {
    previewListeners?.abort();
    const page = preview?.contentDocument;
    if (!page || !status) return;
    const update = () => {
      const root = page.documentElement;
      const nextStatus = getProposalFilmStatus({
        enabled: root.hasAttribute("data-proposal"),
        plain: root.hasAttribute("data-fallback"),
        reason: root.dataset.filmMotionReason,
      });
      if (status.textContent !== nextStatus) status.textContent = nextStatus;
    };
    previewListeners = new AbortController();
    const options = { signal: previewListeners.signal };
    page.addEventListener("proposalfilmchange", update, options);
    page.addEventListener("proposalshaderchange", update, options);
    update();
  };
  preview?.addEventListener("load", bindFilmStatus, options);
  if (preview?.contentDocument?.readyState === "complete") bindFilmStatus();
  window.addEventListener("pagehide", (event) => {
    if (event.persisted) return;
    previewListeners?.abort();
    lifecycle.abort();
  }, options);

  document.querySelector("[data-try-focus]")?.addEventListener("click", () => {
    const summary = preview?.contentDocument?.querySelector<HTMLElement>("[data-details-navigation] summary");
    if (!summary) return;
    summary.focus({ preventScroll: true });
    summary.scrollIntoView({ block: "center", behavior: "instant" });
  }, options);
</script>
