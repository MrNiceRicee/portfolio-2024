---
import "@fontsource-variable/jetbrains-mono";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#050706" />
    <meta name="description" content="This page could not be found. Return to Josh's portfolio." />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <title>404 · Josh Santos</title>
  </head>
  <body data-crt404 data-crt-renderer="static" data-crt-power="on">
    <canvas data-crt-canvas aria-hidden="true"></canvas>
    <main class="screen-copy">
      <h1 data-crt-ink="#d7dec9">404</h1>
      <p data-crt-ink="#a7b09e">Page not found.</p>
      <a data-crt-home data-crt-ink="#b9c3ad" href="/">Return home</a>
    </main>
    <footer data-crt-controls aria-label="Screen controls" hidden>
      <button type="button" data-crt-replay aria-label="Replay power cycle">Replay</button>
      <button type="button" data-crt-power-button aria-label="Power off screen" aria-pressed="true">
        <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><path d="M8 1.5v6M4.4 3.5a5.5 5.5 0 1 0 7.2 0" /></svg>
        <span data-power-label>Power off</span>
      </button>
    </footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; font-family: "JetBrains Mono Variable", monospace; background: #050706; color: #d7dec9; font-synthesis: none; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 280px; min-height: 100svh; overflow: hidden; --edge-feather: min(20vw, 20svh); background: linear-gradient(to right, #000e, transparent var(--edge-feather), transparent calc(100% - var(--edge-feather)), #000e), linear-gradient(to bottom, #000e, transparent var(--edge-feather), transparent calc(100% - var(--edge-feather)), #000e), #101512; }
  ::selection { background: #d7dec9; color: #101512; }
  [hidden] { display: none !important; }
  canvas { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0; }
  [data-crt-renderer="webgl"] canvas { opacity: 1; }
  .screen-copy { position: fixed; inset-inline: 24px; top: 46%; transform: translateY(-50%); text-align: center; }
  h1 { font-size: clamp(144px, 28vw, 280px); font-weight: 400; line-height: 1.05; letter-spacing: -.04em; padding-right: .04em; margin: 0 0 28px; }
  p { color: #a7b09e; font-size: 13px; line-height: 24px; margin: 0 0 16px; }
  a { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 48px; padding: 0 14px; font-size: 12px; line-height: 24px; text-underline-offset: 5px; color: #b9c3ad; border-radius: 3px; }
  a:hover { color: #e8eddf; }
  :where(a, button):focus-visible { outline: 2px solid #d7dec9; outline-offset: 4px; }
  [data-crt-renderer="webgl"] [data-crt-ink] { color: transparent !important; }
  [data-crt-power="off"] .screen-copy { visibility: hidden; }
  footer { position: fixed; bottom: max(20px, env(safe-area-inset-bottom)); left: 20px; right: 20px; display: flex; align-items: center; justify-content: center; gap: 20px; color: #8c948b; font-size: 11px; }
  button { appearance: none; font: inherit; color: inherit; background: transparent; border: 0; border-radius: 3px; min-width: 44px; min-height: 44px; padding: 0 12px; cursor: pointer; }
  button:hover { color: #d7dec9; }
  button:disabled { opacity: .45; cursor: default; }
  button svg { display: inline-block; width: 14px; height: 14px; margin-right: 7px; vertical-align: -2px; }
  @media (max-width: 600px) { .screen-copy { top: 44%; } h1 { font-size: clamp(120px, 38vw, 210px); } footer { gap: 16px; } }
  @media (max-height: 520px) { .screen-copy { top: calc((100svh - 84px) / 2); } h1 { font-size: clamp(60px, 24svh, 120px); margin-bottom: 8px; } p { margin-bottom: 4px; } }
  @media (max-height: 240px) { body { overflow: auto; } .screen-copy { position: relative; inset: auto; transform: none; margin: 24px 24px 16px; } footer { position: relative; inset: auto; margin: 8px 20px max(20px, env(safe-area-inset-bottom)); } }
  @media (forced-colors: active) { body { background: Canvas; color: CanvasText; } h1, p, a { color: CanvasText; } a:focus-visible { outline-color: Highlight; } }
</style>

<script>
  import { initializeCrt404 } from "../scripts/crt404";
  void initializeCrt404();
</script>
