---
import "@fontsource-variable/jetbrains-mono";
import PortfolioTypography from "../components/PortfolioTypography.astro";
import AppearanceIcon from "../components/AppearanceIcon.astro";

const themes = [
  { kind: "light", label: "Light" },
  { kind: "dark", label: "Dark" },
  { kind: "system", label: "System" },
] as const;
const moonOptions = [{ value: "cloud", label: "Cloud clears" }, { value: "full", label: "Crescent to full" }] as const;
const studies = [
  { key: "light", kind: "light", label: "Sun", idle: "Short rays", active: "Extended rays" },
  { key: "dark-cloud", kind: "dark", moonVariant: "cloud", label: "Cloud clears", idle: "Moon + cloud", active: "Clear moon" },
  { key: "dark-full", kind: "dark", moonVariant: "full", label: "Crescent to full", idle: "Crescent", active: "Full moon" },
  { key: "system", kind: "system", label: "System", idle: "Opposite device", active: "Matches device" },
] as const;
---
<!doctype html>
<html lang="en" data-proposal data-appearance-demo>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="An isolated study of idle and active appearance icons." />
    <title>Appearance study · Josh's corner</title>
    <PortfolioTypography />
    <script is:inline>
      const preview = new URLSearchParams(location.search).get("theme");
      const choice = preview === "light" || preview === "dark" ? preview : "system";
      document.documentElement.dataset.demoTheme = choice;
      document.documentElement.classList.toggle("dark", choice === "dark" || (choice === "system" && matchMedia("(prefers-color-scheme: dark)").matches));
    </script>
  </head>
  <body>
    <main>
      <header>
        <a class="back" href="/">← Back to portfolio</a>
        <p class="eyebrow" data-type="metadata">Control studies / 01</p>
        <h1 data-type="name">Appearance study</h1>
      </header>

      <section class="live-study" aria-labelledby="live-heading">
        <div class="live-copy">
          <h2 id="live-heading" data-type="section">Try the switch</h2>
          <p data-type="prose">Choose an appearance to see its 22 px icon change. The menu stays open; use Replay below to repeat a drawing.</p>
          <p class="motion-status" data-type="metadata" data-motion-status role="status">Checking motion preference…</p>
          <div class="demo-controls" data-demo-controls data-open="false" data-interaction="pointer">
          <fieldset class="moon-options">
            <legend>Dark icon</legend>
            {moonOptions.map(({ value, label }) => <label><input type="radio" name="moon-variant" value={value} data-moon-option={value} checked={value === "cloud"} /><span>{label}</span></label>)}
          </fieldset>
            <div class="menu-anchor">
            <button class="menu-trigger" type="button" data-theme-trigger aria-haspopup="menu" aria-expanded="false" aria-controls="appearance-study-menu" aria-label="Appearance: System">
              {themes.map(({ kind }) => <span data-trigger-art={kind} hidden={kind !== "system"}>{kind === "dark" ? moonOptions.map(({ value }) => <span data-moon-art={value} hidden={value !== "cloud"}><AppearanceIcon id={`trigger-dark-${value}`} kind={kind} moonVariant={value} state="active" /></span>) : <AppearanceIcon id={`trigger-${kind}`} kind={kind} state="active" />}</span>)}
              <span data-trigger-label>System</span>
              <span class="chevron" aria-hidden="true">⌄</span>
            </button>
            <div id="appearance-study-menu" class="appearance-menu" role="menu" aria-label="Appearance" data-theme-menu hidden>
              {themes.map(({ kind, label }) => <button type="button" class="menu-choice" role="menuitemradio" aria-checked={kind === "system" ? "true" : "false"} data-theme-choice={kind} tabindex="-1">
                {kind === "dark" ? moonOptions.map(({ value }) => <span data-moon-art={value} hidden={value !== "cloud"}><AppearanceIcon id={`menu-dark-${value}`} kind={kind} moonVariant={value} /></span>) : <AppearanceIcon id={`menu-${kind}`} kind={kind} state={kind === "system" ? "active" : "idle"} />}
                <span>{label}</span>
                <span class="selected-mark" aria-hidden="true">✓</span>
              </button>)}
            </div>
            </div>
          </div>
          <p class="menu-note" data-type="metadata">22 px artwork / temporary preview</p>
        </div>
        <figure class="live-stage">
          <div class="stage-art">
            {themes.map(({ kind }) => <span data-stage-art={kind} hidden={kind !== "system"}>{kind === "dark" ? moonOptions.map(({ value }) => <span data-moon-art={value} hidden={value !== "cloud"}><AppearanceIcon id={`stage-dark-${value}`} kind={kind} moonVariant={value} state="active" size={48} /></span>) : <AppearanceIcon id={`stage-${kind}`} kind={kind} state="active" size={48} />}</span>)}
          </div>
          <figcaption><span class="stage-label" data-stage-label>System · Active</span><span class="stage-note" data-system-note data-device-note>Device: Light. Idle: Dark → Active: Light.</span></figcaption>
        </figure>
      </section>

      <section class="artwork-study" aria-labelledby="artwork-heading">
        <div class="section-heading"><h2 id="artwork-heading" data-type="section">Compare at 22 px</h2><span data-type="metadata">Idle → Active</span></div>
        {studies.map((study, index) => <article class="artwork-row" aria-labelledby={`${study.key}-heading`}>
          <div class="row-heading"><span class="row-number" data-type="metadata">0{index + 1}</span><h3 id={`${study.key}-heading`} data-type="entry">{study.label}</h3></div>
          <figure class="artwork"><AppearanceIcon id={`${study.key}-idle`} kind={study.kind} moonVariant={"moonVariant" in study ? study.moonVariant : "cloud"} size={22} fixed /><figcaption><span>Idle</span><small>{study.idle}</small></figcaption></figure>
          <figure class="artwork" data-replay-art={study.key}><AppearanceIcon id={`${study.key}-active`} kind={study.kind} moonVariant={"moonVariant" in study ? study.moonVariant : "cloud"} state="active" size={22} /><figcaption><span data-replay-label>Active</span><small>{study.active}</small></figcaption></figure>
          <button class="replay" type="button" data-replay={study.key} aria-label={`Replay ${study.label} icon transition`}>Replay <span aria-hidden="true">↗</span></button>
        </article>)}
      </section>

      <footer>
        <p data-type="metadata">Local geometry, anchored outlines. 280 ms, once.</p>
        <p data-type="prose">Keyboard navigation changes states immediately. Reduced motion shows the final drawing without movement.</p>
        <p class="source-note" data-type="metadata">Artwork: <a href="https://lucide.dev/">Lucide</a>. Inspired by <a href="https://lucide-animated.com/">Lucide Animated</a>; this study adapts the artwork with native SVG and CSS transitions. <a href="/third-party/appearance-icons/NOTICE">Sources</a> · <a href="/third-party/appearance-icons/LICENSE">Licenses</a></p>
        <p class="status" role="status" aria-live="polite" aria-atomic="true" data-demo-status>Preview: System. Active drawing shown.</p>
      </footer>
      <noscript><p>The idle and active drawings are visible above. Enable JavaScript to try the menu and replay.</p></noscript>
    </main>
    <script>
      import { initializeAppearanceDemo } from "../scripts/appearanceDemo";
      initializeAppearanceDemo();
    </script>
  </body>
</html>

<style>
  :global(html[data-appearance-demo]) { --demo-surface: #fafaf9; }
  :global(html.dark[data-appearance-demo]) { --demo-surface: #0c0a09; }
  body { --appearance-surface: var(--demo-surface); margin: 0; background: var(--demo-surface); }
  main { max-width: 880px; margin: 0 auto; padding: 16px clamp(20px, 5vw, 48px) 48px; }
  button, a { color: inherit; }
  button { --appearance-surface: var(--demo-surface); font: inherit; border: 1px solid currentColor; background: var(--appearance-surface); cursor: pointer; min-height: 44px; }
  :is(button, a):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  a { display: inline-flex; align-items: center; min-height: 44px; }
  .back { font-size: 0.875rem; text-decoration-thickness: 1px; }
  .eyebrow { margin: 8px 0; }
  .live-study { display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; padding: 20px 0; margin-top: 20px; border-block: 1px solid color-mix(in srgb, currentColor 25%, transparent); }
  h2, h3, p, figure { margin: 0; }
  .live-copy > p { margin-top: 12px; max-width: 38ch; }
  .demo-controls { width: fit-content; max-width: 100%; margin-top: 12px; z-index: 1; position: relative; }
  .menu-anchor { position: relative; width: max-content; }
  .menu-trigger { min-width: 156px; display: flex; align-items: center; gap: 12px; padding: 10px 12px; }
  .chevron { margin-left: auto; line-height: 1; }
  .appearance-menu { position: absolute; inset: calc(100% + 8px) auto auto 0; width: 208px; max-width: calc(100vw - 40px); padding: 4px; box-sizing: border-box; border: 1px solid currentColor; background: var(--demo-surface); }
  [data-open="false"] .appearance-menu { display: none; }
  .menu-choice { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; padding: 10px 12px; border: 0; }
  .selected-mark { margin-left: auto; visibility: hidden; }
  [aria-checked="true"] .selected-mark { visibility: visible; }
  .moon-options { border: 0; padding: 0; margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 0 16px; font-size: 0.75rem; }
  .moon-options legend { padding: 0; font-weight: 600; }
  .moon-options label { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; cursor: pointer; }
  .moon-options input { margin: 0; accent-color: currentColor; }
  .moon-options input:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .menu-note { font-size: 0.75rem !important; }
  .motion-status { margin-top: 8px; font-size: 0.75rem !important; max-width: 40ch; }
  .source-note { font-size: 0.75rem !important; }
  .source-note a { min-height: auto; display: inline; }
  .live-stage { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; min-height: 144px; }
  .stage-art { min-height: 48px; display: grid; align-items: center; }
  .live-stage figcaption { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 0.875rem; }
  .stage-label { font-weight: 600; }
  .stage-note { font-size: 0.75rem; min-height: 1.5em; max-width: 32ch; }
  .artwork-study { margin-top: 40px; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; padding-bottom: 24px; }
  .section-heading > span { white-space: nowrap; font-size: 0.75rem; }
  .artwork-row { display: grid; grid-template-columns: 1.1fr 1fr 1fr auto; align-items: center; column-gap: 24px; padding: 24px 0; border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent); }
  .row-heading { display: flex; align-items: baseline; gap: 12px; }
  .row-number { font-size: 0.75rem; }
  .artwork { display: flex; flex-direction: column; gap: 12px; }
  .artwork figcaption { display: flex; flex-direction: column; gap: 4px; font-size: 0.875rem; }
  .artwork small { font-size: 0.75rem; }
  .replay { font-size: 0.875rem; display: inline-flex; align-items: center; gap: 12px; padding: 8px 12px; }
  footer { border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent); padding-top: 24px; margin-top: 8px; display: flex; flex-direction: column; gap: 12px; }
  footer [data-type="prose"] { font-size: 0.875rem; }
  .status { font-size: 0.875rem; min-height: 1.6em; }
  :global([hidden]) { display: none !important; }
  @media (hover: hover) and (pointer: fine) { button:hover { --appearance-surface: color-mix(in srgb, currentColor 6%, var(--demo-surface)); } }
  button:active { --appearance-surface: color-mix(in srgb, currentColor 10%, var(--demo-surface)); }
  @media (max-width: 620px) {
    .live-study { grid-template-columns: 1fr; gap: 24px; }
    .live-stage { min-height: 80px; flex-direction: row; justify-content: flex-start; gap: 32px; }
    .live-stage figcaption { align-items: flex-start; }
    .section-heading { flex-direction: column; gap: 8px; }
    .artwork-row { grid-template-columns: 1fr 1fr; gap: 24px 16px; }
    .row-heading { grid-column: 1 / -1; }
    .replay { grid-column: 1 / -1; justify-self: start; }
  }

</style>
